<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground layer for Android API 25 (7.1).
     API 26+ devices use the PNG in mipmap-* via mipmap-anydpi-v26/ic_launcher.xml.
     This transparent vector prevents the default Capacitor robot icon from
     showing on API 25 devices while keeping the dark brand background. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h108v108h-108z" />
</vector>
