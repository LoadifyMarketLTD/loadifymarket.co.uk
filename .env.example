# Public (frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable analytics.
VITE_GA_MEASUREMENT_ID=

# Server (Netlify Functions) - do not expose in frontend
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required for Stripe Connect account.updated webhook events from connected Express accounts.
# The same /.netlify/functions/stripe-webhook endpoint handles BOTH regular and Connect
# webhooks — the handler tries STRIPE_WEBHOOK_SECRET first then falls back to this secret.
# Setup in the NEW Stripe platform account:
#   1. Standard webhook:
#      Dashboard → Developers → Webhooks → Add endpoint
#      URL: https://loadifymarket.co.uk/.netlify/functions/stripe-webhook
#      Events: checkout.session.completed, charge.refunded, payment_intent.succeeded,
#              payment_intent.payment_failed, charge.dispute.created, transfer.created
#      Copy the signing secret → set as STRIPE_WEBHOOK_SECRET
#   2. Connect webhook (for seller onboarding status updates and payouts):
#      Dashboard → Connect → Webhooks → Add endpoint
#      URL: https://loadifymarket.co.uk/.netlify/functions/stripe-webhook
#      Events: account.updated, payout.paid
#      Copy the signing secret → set as STRIPE_CONNECT_WEBHOOK_SECRET
STRIPE_CONNECT_WEBHOOK_SECRET=

# Internal secret shared between Netlify Functions for server-to-server calls.
# send-email.ts validates this header (X-Internal-Secret) for non-public templates.
# Generate a strong random value (e.g. openssl rand -hex 32) and set the same
# value in all Netlify functions that call send-email internally.
NETLIFY_INTERNAL_SECRET=

# Email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=contact@loadifymarket.co.uk

# Supabase Storage
SUPABASE_BUCKET_NAME=proof-of-delivery

# App settings
VITE_APP_URL=https://loadifymarket.co.uk
VITE_SUPPORT_EMAIL=contact@loadifymarket.co.uk
VITE_SUPPORT_PHONE=+447423272138
VITE_CURRENCY=GBP
VITE_CURRENCY_SYMBOL=£
# 0% commission promotion is active until 31 December 2026 23:59:59 UTC.
# This variable controls UI display only — Stripe fee logic is enforced
# server-side in stripe-webhook.ts via getCommissionRate().
# Set to 7 after the promotion ends and update ZERO_COMMISSION_PROMO_END_UTC.
VITE_MARKETPLACE_FEE_PERCENT=0
VITE_RETURNS_DAYS=14
VITE_VAT_ENABLED=true
VITE_VAT_NUMBER=GB375949535
VITE_VAT_MODE=FLAT_RATE
VITE_VAT_DISPLAY=SEPARATE

# Company Details
VITE_COMPANY_NAME=XDrive Logistics Ltd
VITE_COMPANY_ADDRESS=101 Cornelian Street, Blackburn, BB1 9QL, United Kingdom

# Admin Notifications
# Email address that receives admin notification emails (new seller registrations,
# verification requests, new buyer registrations, etc.) sent by Netlify Functions.
# Must match the SendGrid verified sender or a verified domain address.
ADMIN_NOTIFICATION_EMAIL=contact@loadifymarket.co.uk

# Site URL (used in email links and Stripe return URLs)
SITE_URL=https://loadifymarket.co.uk

# Escrow auto-release window in days (optional, default 7).
# Orders in 'delivered' status with escrow held for longer than this period
# are automatically released by the escrow-release scheduled function.
ESCROW_WINDOW_DAYS=7

# Build metadata (optional, injected by CI/Netlify at build time).
# These are exposed via import.meta.env in the frontend for error tracking.
# Leave blank for local development — they default to 'local'/'0'/'unknown'.
VITE_BUILD_SHA=
VITE_BUILD_NUMBER=
VITE_BUILD_TIME=

# Credentialed E2E release gate (local operator only; never commit real values).
# `npm run e2e:release` is fail-closed and requires all values below.
E2E_BASE_URL=https://loadifymarket.co.uk
E2E_TARGET_SHA=
E2E_RELEASE_TARGET=production
E2E_ALLOW_PRODUCTION_READONLY=
E2E_BUYER_EMAIL=
E2E_BUYER_PASSWORD=
E2E_SELLER_EMAIL=
E2E_SELLER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Must identify a real order owned by a different seller than E2E_SELLER_EMAIL.
# The Seller mutation test expects 403 and must not change the order.
E2E_FOREIGN_ORDER_ID=

# Netlify automatically injects URL in production (https://your-site.netlify.app
# or your custom domain). Set it here only for local netlify dev testing:
# URL=http://localhost:8888

