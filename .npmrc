# Allow npm ci / npm install to skip peer dependency version checks.
# Required because react-day-picker@8.x and recharts@2.x declare peer deps
# on react@^16||^17||^18 and date-fns@^2||^3, while this project uses
# react@19 and date-fns@4. Both libraries work correctly at runtime with
# the newer versions; this flag tells npm to skip the strict check.
legacy-peer-deps=true
